# Copy this file to .env in the same folder, then fill in your real values.
# In IntelliJ: right-click this file, Copy, paste into the same folder, and name
# the copy .env
#
# Use the same username and API key as A0. Both are on your BRIDGES profile page:
#   https://bridges-cs.herokuapp.com/login  ->  log in  ->  profile (upper right)
#
# .env is listed in .gitignore; leave it there. Do not commit this file, and do
# not paste your API key into Slack, Piazza, email, or a bug report. If it does
# get out, regenerate it from the profile page, which invalidates the old one.

BRIDGES_USERNAME=your-bridges-username
BRIDGES_APIKEY=your-bridges-api-key

# Every visualization you push is filed under an assignment number. Leave this
# at 4 for A4.
BRIDGES_ASSIGNMENT=4
